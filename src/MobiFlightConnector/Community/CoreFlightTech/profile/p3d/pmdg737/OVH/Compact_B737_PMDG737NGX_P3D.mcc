    <config guid="285da327-0ac5-465d-89b3-3fd41adff60b">
      <active>true</active>
      <description>EGT GAUGE</description>
      <settings msdata:InstanceType="MobiFlight.OutputConfigItem, MFConnector, Version=10.5.3.0, Culture=neutral, PublicKeyToken=null" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
        <source type="FSUIPC" offset="0x648C" offsetType="Float" size="4" mask="0xFFFFFFFF" bcdMode="False" />
        <test type="Float" value="100" />
        <modifiers>
          <interpolation active="True">
            <value x="0" y="0" />
            <value x="1100" y="1500" />
          </interpolation>
          <transformation active="True" expression="$ + 10" />
        </modifiers>
        <display type="Stepper" serial="CFT_B737_C_OVH/ SN-D8F-39D" trigger="normal" stepperAddress="EGT_Gauge" stepperInputRev="1000" stepperOutputRev="2040" stepperTestValue="500" stepperCompassMode="False" stepperAcceleration="800" stepperSpeed="467" />
        <preconditions />
        <configrefs />
      </settings>
    </config>
