<MobiflightConnector>
  <outputs>
    <config guid="8f16c4fe-e36d-46a5-b131-38a362f4c6d8">
      <active>false</active>
      <description>----- Backlight: Enable only One option below -----</description>
      <settings msdata:InstanceType="MobiFlight.OutputConfigItem, MFConnector, Version=10.5.3.0, Culture=neutral, PublicKeyToken=null" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
        <source type="SimConnect" VarType="LVAR" Value="" />
        <test type="Float" value="1" />
        <modifiers>
          <comparison active="True" value="" operand="=" ifValue="1" elseValue="0" />
        </modifiers>
        <display type="" serial="-" trigger="change" pin="" pinBrightness="255" />
        <preconditions />
        <configrefs />
      </settings>
    </config>
    <config guid="cd427d41-b776-49c2-bbb7-2e0f31cb2380">
      <active>true</active>
      <description>[Option A]  Backlight Increase-&gt;Press&amp;Hold = LandALT  Decrease-&gt;Press&amp;Hold FltALT</description>
      <settings msdata:InstanceType="MobiFlight.OutputConfigItem, MFConnector, Version=10.5.3.0, Culture=neutral, PublicKeyToken=null" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
        <source type="FSUIPC" offset="0x6497" offsetType="Integer" size="1" mask="0x00FF" bcdMode="False" />
        <test type="Float" value="20" />
        <modifiers>
          <transformation active="True" expression="$ * 1.7" />
        </modifiers>
        <display type="Output" serial="CFT_B737_C_OVH/ SN-D8F-39D" trigger="normal" pin="Backlight_PWM" pinBrightness="255" pinPwm="True" />
        <preconditions />
        <configrefs />
      </settings>
    </config>
    <config guid="ecbbcf13-9bac-4ca9-8ce2-49ee8986f11c">
      <active>false</active>
      <description>[Option B]  Backlight always on (full brightness, independent from sim)</description>
      <settings msdata:InstanceType="MobiFlight.OutputConfigItem, MFConnector, Version=10.5.3.0, Culture=neutral, PublicKeyToken=null" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
        <source type="SimConnect" VarType="CODE" Value="(L:BL_Overhead, number)" UUID="b6d82fcc-ae10-4853-bd1e-2b5423f9148b" />
        <test type="Float" value="20" />
        <modifiers>
          <comparison active="True" value="-1" operand="!=" ifValue="1" elseValue="1" />
          <interpolation active="False">
            <value x="0" y="0" />
            <value x="1" y="255" />
          </interpolation>
        </modifiers>
        <display type="Output" serial="CFT_B737_C_OVH/ SN-D8F-39D" trigger="normal" pin="Backlight_PWM" pinBrightness="255" />
        <preconditions />
        <configrefs />
      </settings>
    </config>
