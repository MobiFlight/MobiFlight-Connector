<Project Sdk="MSTest.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<DefineConstants>TRACE;DEBUG;ARCAZE</DefineConstants>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<DefineConstants>TRACE;ARCAZE</DefineConstants>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Moq" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="assets\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\MobiFlightConnector\MobiFlightConnector.csproj" />
		<ProjectReference Include="..\..\src\MobiFlightWwFcu\MobiFlightWwFcu.csproj" />
	</ItemGroup>

	<Target Name="CustomPreBuild" BeforeTargets="Build">
		<ItemGroup>
			<MccFiles Include="$(SolutionDir)src\MobiFlightConnector\examples\*.mcc" />
		</ItemGroup>

		<MakeDir Directories="$(TargetDir)assets\Base\ConfigFile" />

		<Copy SourceFiles="@(MccFiles)" DestinationFolder="$(TargetDir)assets\Base\ConfigFile" SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(SolutionDir)lib\x86\SimConnect.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
